# ========================================
# CONFIGURACIÓN DE NEXTAUTH
# ========================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here # Generar con: openssl rand -base64 32

# ========================================
# CONFIGURACIÓN DE AUTHENTIK
# ========================================
AUTHENTIK_CLIENT_ID=your-client-id-from-authentik
AUTHENTIK_CLIENT_SECRET=your-client-secret-from-authentik
AUTHENTIK_ISSUER=https://auth.sergihno.cl/application/o/ankh/

# URLs de redirección que debes configurar en Authentik:
# - http://localhost:3000/api/auth/callback/authentik
# - http://localhost:3000/auth/signin
# - http://localhost:3000/auth/error

# Configuración de la sesión
NEXTAUTH_URL_INTERNAL=http://localhost:3000

# ========================================
# CONFIGURACIÓN DE OPENAI
# ========================================
# ¡CRÍTICO! Requerido para las interpretaciones de tarot
OPENAI_API_KEY=sk-your-openai-api-key-here

# ========================================
# CONFIGURACIÓN DE ENTORNO
# ========================================
NODE_ENV=development # Cambiar a "production" en producción
